{
  "manifest_version": 3,
  "name": "Gmail to GHL Opportunity Creator",
  "version": "1.0.0",
  "description": "Create GoHighLevel opportunities directly from Gmail.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://mail.google.com/*",
    "https://services.leadconnectorhq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["content_script.js"],
      "css": ["styles.css"]
      // Note: InboxSDK integration would typically involve loading their script first.
      // For this prototype, we'll start without it and add integration later if feasible.
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    // "default_popup": "popup.html", // Optional: Can add later if needed
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

